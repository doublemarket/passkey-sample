# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production

# WebAuthn Configuration
RP_NAME=Passkey Auth App
RP_ID=localhost
ORIGIN=http://localhost:3000

# Apple App Site Association
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_BUNDLE_ID=com.yakst.passkeyauthapp

# Android Digital Asset Links
ANDROID_PACKAGE_NAME=com.yakst.passkeyauthapp
ANDROID_SHA256_CERT_FINGERPRINTS=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
# Optional: add app links relation for troubleshooting (default: false)
ANDROID_HANDLE_ALL_URLS=false
# Optional: android:apk-key-hash values (base64url)
ANDROID_APK_KEY_HASHES=

# Database
DB_PATH=./data/database.sqlite
